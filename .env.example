# Copy to .env and fill in. Never commit .env.
#
# Live market + news retrieval: Alpaca key id and secret.
# Live news classification: OpenAI API key. Without it, articles are stored
# and every candidate is deferred (no news signal, no news event).
# Create a key at https://platform.openai.com/api-keys

INVESTMENT_ASSISTANT_ALPACA_API_KEY_ID=
INVESTMENT_ASSISTANT_ALPACA_API_SECRET_KEY=
INVESTMENT_ASSISTANT_OPENAI_API_KEY=
INVESTMENT_ASSISTANT_ALPACA_FEED=iex
INVESTMENT_ASSISTANT_ALPACA_TRADING_URL=https://paper-api.alpaca.markets
INVESTMENT_ASSISTANT_WATCHLIST=TSLA,AMD
INVESTMENT_ASSISTANT_LOG_LEVEL=INFO
INVESTMENT_ASSISTANT_LOG_JSON=true
# Optional. Off by default. Independent of watch log.
INVESTMENT_ASSISTANT_HEARTBEAT=false
# Optional. Off by default. Verbose human-readable run narrative.
INVESTMENT_ASSISTANT_WATCH_LOG=false
INVESTMENT_ASSISTANT_DATABASE_PATH=investment_assistant.db
