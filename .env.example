# Copy to .env and fill in. Never commit .env.
#
# Live market + news retrieval: Alpaca key id and secret.
# Live news classification and live research: OpenAI API key. Without it,
# articles are stored and every candidate is deferred (no news signal), and
# queued research stays retryable with no report and no fake report.
# Create a key at https://platform.openai.com/api-keys
# Optional SEC contact string, for example: Your Name you@example.com
# If blank, filing tools return unavailable and research continues.
# Optional live Discord destination. Keep this webhook URL secret.

INVESTMENT_ASSISTANT_ALPACA_API_KEY_ID=
INVESTMENT_ASSISTANT_ALPACA_API_SECRET_KEY=
INVESTMENT_ASSISTANT_OPENAI_API_KEY=
INVESTMENT_ASSISTANT_DISCORD_WEBHOOK_URL=
INVESTMENT_ASSISTANT_SEC_USER_AGENT=
INVESTMENT_ASSISTANT_ALPACA_FEED=iex
INVESTMENT_ASSISTANT_ALPACA_TRADING_URL=https://paper-api.alpaca.markets
INVESTMENT_ASSISTANT_WATCHLIST=TSLA,AMD
# Lowerable UTC model-call and estimated-cost limits. Zero defers new calls.
INVESTMENT_ASSISTANT_RESEARCH_STARTS_PER_DAY=20
INVESTMENT_ASSISTANT_CLASSIFIER_CALLS_PER_DAY=100
INVESTMENT_ASSISTANT_CLASSIFIER_CALLS_PER_PASS=20
INVESTMENT_ASSISTANT_DAILY_MODEL_BUDGET_USD=2.00
INVESTMENT_ASSISTANT_LOG_LEVEL=INFO
INVESTMENT_ASSISTANT_LOG_JSON=true
# Optional. Off by default. Independent of watch log. Each minute it shows
# delivery backlog and age, estimated USD ledger, and per-kind model admission.
INVESTMENT_ASSISTANT_HEARTBEAT=false
# Optional. Off by default. Human-readable state-change narrative.
INVESTMENT_ASSISTANT_WATCH_LOG=false
INVESTMENT_ASSISTANT_DATABASE_PATH=investment_assistant.db
